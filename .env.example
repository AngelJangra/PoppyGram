# PoppyGram — copy to .env.local and fill in. Keys only; never commit values.
# `cp .env.example .env.local`

# ── Supabase (shared by the site and api/support.py) ──────────────────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Encryption (32 raw bytes, base64 encoded) for Telegram sessions ───────
ENCRYPTION_KEY_BASE64_32_BYTES=

# ── Admin console ─────────────────────────────────────────────────────────
ADMIN_PASSWORD_HASH=

# ── Telegram MTProto (admin console ping scheduler, browser side) ─────────
NEXT_PUBLIC_TG_API_ID=
NEXT_PUBLIC_TG_API_HASH=

# ── Store bot (pages/api/bot.ts) ──────────────────────────────────────────
TG_BOT_TOKEN=
TG_BOT_WEBHOOK_SECRET=
TG_OWNER_CHAT_ID=

# ── Support bot (api/support.py, webhook at POST /api/support) ────────────
SUPPORT_BOT_TOKEN=
SUPPORT_BOT_WEBHOOK_SECRET=

# ── Misc ──────────────────────────────────────────────────────────────────
SITE_URL=
CRON_SECRET=
